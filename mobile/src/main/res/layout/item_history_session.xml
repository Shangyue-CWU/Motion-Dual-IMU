<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <!-- Main Session Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/sessionCard"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="2dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp">

            <!-- Session Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSessionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Walking Session"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/tvSessionDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="May 27, 2026 • 2:41 PM"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Right-side Selection Indicator -->
            <FrameLayout
                android:id="@+id/selectionIndicator"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_selection_indicator"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:tint="#7DD3FC"/>
            </FrameLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>